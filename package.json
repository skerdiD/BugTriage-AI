{
  "name": "bugtriage-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.21.0 <23 || >=24.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx src/workers/bug-analysis.worker.ts",
    "worker:dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --watch --import tsx src/workers/bug-analysis.worker.ts",
    "republish": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx src/workers/ticket-analysis-republisher.ts",
    "backfill:embeddings": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx src/workers/ticket-embedding-backfill.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run --passWithNoTests",
    "test:db": "prisma migrate deploy && vitest run --config vitest.db.config.mts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "seed:demo": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ai-sdk/google": "3.0.67",
    "@arcjet/next": "1.9.1",
    "@hookform/resolvers": "5.2.2",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@radix-ui/react-avatar": "1.1.10",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-progress": "1.1.7",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@sentry/nextjs": "10.70.0",
    "@supabase/ssr": "0.10.2",
    "@supabase/supabase-js": "2.105.3",
    "ai": "6.0.175",
    "bullmq": "^6.0.9",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "ioredis": "^6.0.0",
    "lucide-react": "1.14.0",
    "next": "16.3.0",
    "pg": "8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "15.0.0",
    "react-hook-form": "7.75.0",
    "recharts": "3.8.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "4.2.4",
    "@types/node": "20.19.39",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "prisma": "7.9.1",
    "tailwindcss": "4.2.4",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  },
  "overrides": {
    "@prisma/dev": {
      "@hono/node-server": "1.19.13"
    },
    "deepmerge-ts": "8.0.2",
    "next": {
      "postcss": "8.5.26"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
