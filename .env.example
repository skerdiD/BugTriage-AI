# Existing external PostgreSQL database with pgvector. Docker does not create one.
DATABASE_URL=""
# Optional direct migration connection; falls back to DATABASE_URL when empty.
DIRECT_URL=""

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Server-only. Required for private Supabase Storage uploads and signed URLs.
SUPABASE_SERVICE_ROLE_KEY=""
# Defaults to bugtriage-private when empty. Create this bucket as private in Supabase Storage.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=""

GOOGLE_GENERATIVE_AI_API_KEY=""
ARCJET_KEY=""

# Redis / BullMQ. Use a native Redis TCP URL (rediss:// for Upstash TLS), not
# Upstash REST credentials. PostgreSQL retains pending jobs if Redis is unavailable.
REDIS_URL=""
BULLMQ_WORKER_CONCURRENCY="3"
# Dedicated Compose republisher runs one batch every 15 seconds, without overlap.
# npm run republish remains a one-shot command for external schedulers.
TICKET_ANALYSIS_REPUBLISH_INTERVAL_MS="15000"
# Keep false for hosted Redis. Docker Compose explicitly enables this only on its private network.
REDIS_ALLOW_INSECURE_CONNECTION="false"

# Server-only GitHub Issues export configuration. Prefer a fine-grained token
# limited to this repository with only Issues: write permission.
GITHUB_TOKEN=""
GITHUB_REPOSITORY_OWNER=""
GITHUB_REPOSITORY_NAME=""

APP_URL=""
NEXT_PUBLIC_APP_URL=""

# Docker only: binds the web port to loopback by default. Use 0.0.0.0 when
# intentionally serving through a remote reverse proxy or published interface.
APP_BIND_ADDRESS="127.0.0.1"
APP_PORT="3000"

# Server-side Sentry DSN for production error reporting.
SENTRY_DSN=""
# Optional browser DSN. If omitted, client-side Sentry will fall back to SENTRY_DSN.
NEXT_PUBLIC_SENTRY_DSN=""
# Optional Sentry telemetry controls. Defaults: logs on, replay 100% in dev,
# replay 10% in production, error replays 100%.
SENTRY_LOGS_ENABLED="true"
NEXT_PUBLIC_SENTRY_LOGS_ENABLED="true"
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=""
NEXT_PUBLIC_SENTRY_REPLAYS_ERROR_SAMPLE_RATE=""
# Secret auth token for source map uploads during builds. Never expose this to the browser.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Source maps upload automatically in CI/Vercel. Set true for another trusted build system.
SENTRY_UPLOAD_SOURCE_MAPS=""
